---
import { Locale, t } from "@lib/i18n";

import DocSearchButton from "./docsearch-button";
import DocSearchInput from "./docsearch-input";

import "@docsearch/css/dist/style.css";

interface Props {
  placeHolder?: string;
  size?: "sm" | "md" | "lg";
  locale?: Locale;
}
const {
  placeHolder = t("component.search.title"),
  size = "md",
  locale = Locale.English,
} = Astro.props;
---

<style is:global>
  @reference "../../styles/tailwind.css";

  /* docsearch only resets the block-start padding @tailwindcss/forms adds */
  .DocSearch-Input {
    @apply py-0 ring-0 ring-transparent;
  }

  /* the modal goes full bleed here, but the bar and footer still round */
  @media (max-width: 768px) {
    .DocSearch-Container {
      --docsearch-modal-radius: 0px;
    }
  }

  /* https://github.com/algolia/docsearch/blob/main/packages/docsearch-css/src/_variables.css */

  /* on the modal, not :root, to beat docsearch's own [data-theme="dark"] */
  .DocSearch-Container {
    --docsearch-primary-color: var(--color-blue-500);
    --docsearch-primary-dark-color: var(--color-blue-600);
    --docsearch-soft-primary-color: color-mix(
      in srgb,
      var(--docsearch-primary-color) 10%,
      transparent
    );
    --docsearch-highlight-color: var(--docsearch-primary-color);
    --docsearch-focus-color: var(--docsearch-primary-color);

    /* docsearch tints its greys blue, ours are neutral */
    --docsearch-text-color: var(--color-gray-900);
    --docsearch-secondary-text-color: var(--color-gray-500);
    --docsearch-icon-color: var(--color-gray-500);
    --docsearch-muted-color: var(--color-gray-400);
    --docsearch-subtle-color: var(--color-gray-200);
    --docsearch-container-background: rgba(107, 114, 128, 0.8);
    --docsearch-background-color: var(--color-gray-50);
    --docsearch-hit-color: var(--color-gray-700);
    --docsearch-hit-focus-background: var(--color-gray-50);
    --docsearch-key-background: var(--color-gray-100);
    --docsearch-key-color: var(--color-gray-500);
  }

  html.dark .DocSearch-Container {
    --docsearch-primary-color: var(--color-blue-600);
    --docsearch-primary-dark-color: var(--color-blue-300);

    --docsearch-text-color: var(--color-gray-200);
    --docsearch-secondary-text-color: var(--color-gray-400);
    --docsearch-icon-color: var(--color-gray-400);
    --docsearch-muted-color: var(--color-gray-400);
    --docsearch-subtle-color: var(--color-dark-gray-800);
    --docsearch-container-background: rgba(3, 3, 3, 0.8);
    --docsearch-background-color: var(--color-dark-gray-900);

    /* the bar and footer are darker bands, the hits sit flat on the modal */
    --docsearch-modal-background: var(--color-dark-gray-950);
    --docsearch-searchbox-focus-background: var(--color-dark-gray-975);
    --docsearch-footer-background: var(--color-dark-gray-975);
    --docsearch-hit-background: var(--color-dark-gray-950);
    --docsearch-hit-focus-background: var(--color-dark-gray-975);
    --docsearch-hit-color: var(--color-gray-200);

    --docsearch-key-background: var(--color-dark-gray-800);
    --docsearch-key-color: var(--color-gray-300);
    --docsearch-logo-color: rgb(255, 255, 255);

    --docsearch-modal-shadow:
      inset 1px 1px 0 0 var(--color-dark-gray-800),
      0 3px 8px 0 rgba(0, 0, 0, 0.6);
    --docsearch-footer-shadow:
      inset 0 1px 0 0 var(--color-dark-gray-800),
      0 -4px 8px 0 rgba(0, 0, 0, 0.2);
  }
</style>

<DocSearchInput
  client:only="react"
  placeHolder={placeHolder}
  size={size}
  locale={locale}
>
  <DocSearchButton slot="fallback" placeHolder={placeHolder} size={size} />
</DocSearchInput>
