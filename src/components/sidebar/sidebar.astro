---
import DocSearch from "@components/docsearch/docsearch.astro";
import ModeSelect from "@components/theme/mode-select.astro";

import { MOBILE_BREAKPOINT } from "@lib/constants/breakpoints";
import type { SidebarStructure } from "@lib/docs/types";
import { Locale, t } from "@lib/i18n";
import type { TagsResponse } from "@lib/types";
import { getCompressedVersions } from "@lib/versions/list";

import SidebarContent from "./sidebar-content.astro";
import Selectors from "./sidebar-selectors";

interface Props {
  sidebar: SidebarStructure;
  file: string;
  major: string;
  minor: string;
  tags: TagsResponse;
}

const { sidebar, file, major, minor, tags } = Astro.props;

// use precompressed versions to reduce the initial payload
const compressedVersions = await getCompressedVersions(Locale.English);

const searchTitle = t("component.search.title");

const sidebarScript = `try {
  const isMobile = window.matchMedia("(width < ${MOBILE_BREAKPOINT}px)");
  const stored = localStorage.getItem("sidebar");
  const sidebarState = stored === null ? true : stored === "true";
  const open = isMobile.matches ? false : sidebarState;
  if (open) document.querySelector(".sidebar")?.classList.add("open");
} catch {}`;
---

<style>
  @reference "../../styles/tailwind.css";

  .sidebar {
    position: sticky;
    top: 3rem;
    z-index: 9;
    width: 400px;
    height: calc(100vh - 3rem);
    @supports (height: 100dvh) {
      height: calc(100dvh - 3rem);
    }

    .content {
      -webkit-transform: translateZ(0);
    }

    @apply bg-white;
    :global(.dark) & {
      @apply bg-dark-gray-950;
    }

    @apply grid grid-rows-[auto_1fr_auto];
    @apply border-r;
    @apply border-l;
    @apply border-gray-200;
    :global(.dark) & {
      @apply border-dark-gray-800;
    }

    /* lg screen and below */
    @variant max-lg {
      position: fixed;
      transform: translateX(-100%);
      /* like silk */
      will-change: transform;

      width: 80%;
      @variant md {
        width: auto;
        min-width: 50%;
      }

      & {
        transition: transform ease-in-out 150ms;
      }

      &.open {
        transform: translateX(0);
      }
    }

    @variant lg {
      /* hide if not open */
      &:not(.open) {
        display: none;
      }
    }

    /* when on mobile, wait for the component to be mounted
    so as to prevent a closing animation when loading the page */
    @variant max-lg {
      &:not(.mounted) {
        display: none;
      }
    }
  }

  .sidebar-mask {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 8;
    display: none;
    pointer-events: none;

    @variant max-lg {
      background-color: rgba(0, 0, 0, 0.3);
    }
  }

  @variant max-lg {
    .sidebar.open ~ .sidebar-mask {
      display: block;
      pointer-events: auto;
      animation: fade-in 300ms;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .bottom-safe-area-inset {
    @supports (padding: max(0px)) {
      &.inset-3 {
        padding-bottom: max(0.75rem, env(safe-area-inset-bottom)) !important;
      }
      &.inset-2 {
        padding-bottom: max(0.5rem, env(safe-area-inset-bottom)) !important;
      }
    }
  }
</style>

<div>
  <aside class="sidebar">
    <div class="w-full border-b border-gray-200 p-4 dark:border-dark-gray-800">
      <Selectors
        transition:persist="sidebar-selectors"
        client:load
        major={major}
        minor={minor}
        file={file}
        compressedVersions={compressedVersions}
        tags={tags}
      />
      <div class="mt-4 hidden lg:block">
        <label class="sr-only mb-1 block text-sm font-bold" for="filter">
          {searchTitle}
        </label>
        <DocSearch locale={Locale.English} />
      </div>
    </div>
    <SidebarContent sidebar={sidebar} file={file} />
    <div
      class="bottom-safe-area-inset inset-2 flex w-full flex-row items-center justify-end border-t border-gray-200 bg-white px-4 py-2 dark:border-dark-gray-800 dark:bg-dark-gray-950"
    >
      <ModeSelect transition:persist="sidebar-mode-select" />
    </div>
  </aside>
  <div class="sidebar-mask" transition:persist="sidebar-mask"></div>
</div>

<script is:inline set:html={sidebarScript} />

<script>
  import type { TransitionBeforePreparationEvent } from "astro:transitions/client";

  import { MOBILE_BREAKPOINT } from "@lib/constants/breakpoints";
  import { sidebarOpen } from "@stores/sidebar-open";

  document.addEventListener("astro:before-swap", (event) => {
    const sidebar = event.newDocument.querySelector(".sidebar");
    // apply state before the replacement is painted, including on mobile
    sidebar?.classList.toggle("open", sidebarOpen.get());
    sidebar?.classList.add("mounted");
  });

  document.addEventListener("astro:page-load", () => {
    const sidebar = document.querySelector<HTMLElement>(".sidebar");
    const mask = document.querySelector(".sidebar-mask");
    if (!sidebar || !mask) return;
    const mobile = window.matchMedia(`(width < ${MOBILE_BREAKPOINT}px)`);
    const listeners = new AbortController();
    const { signal } = listeners;

    // the page scrolls on <html>, so overflow: hidden on <body> does nothing —
    // and setting it on <html> breaks the sticky header on iOS safari
    // take the body out of flow instead, restoring scroll position on unlock
    let lockedScrollY = 0;
    let isLocked = false;

    const unlockBodyScroll = () => {
      if (!isLocked) return;
      isLocked = false;
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.left = "";
      document.body.style.right = "";
      window.scrollTo({ top: lockedScrollY, behavior: "instant" });
    };

    const updateBodyScroll = () => {
      const shouldLock = mobile.matches && sidebarOpen.get();
      if (shouldLock === isLocked) return;
      if (shouldLock) {
        isLocked = true;
        lockedScrollY = window.scrollY;
        document.body.style.position = "fixed";
        document.body.style.top = `-${lockedScrollY}px`;
        document.body.style.left = "0";
        document.body.style.right = "0";
      } else {
        unlockBodyScroll();
      }
    };

    const unsub = sidebarOpen.subscribe((open) => {
      sidebar.classList.toggle("open", open);
      updateBodyScroll();
    });

    const handleMaskClick = () => sidebarOpen.set(false);
    // close the drawer before the anchor jump so the scroll lock does not
    // prevent scrolling to the selected heading
    const handleLinkClick = (event: MouseEvent) => {
      const target = event.target as Element | null;
      if (mobile.matches && target?.closest("a[href^='#']")) {
        sidebarOpen.set(false);
      }
    };

    const prepareNavigation = (event: TransitionBeforePreparationEvent) => {
      const load = event.loader;
      // unlock after loading so astro saves the real scroll position
      event.loader = async () => {
        await load();
        if (!event.signal.aborted && !signal.aborted) unlockBodyScroll();
      };
      event.signal.addEventListener("abort", updateBodyScroll, {
        once: true,
        signal,
      });
    };

    const cleanup = () => {
      unsub();
      listeners.abort();
      unlockBodyScroll();
    };

    document.addEventListener("astro:before-preparation", prepareNavigation, {
      signal,
    });
    document.addEventListener("astro:before-swap", cleanup, {
      once: true,
      signal,
    });
    mask.addEventListener("click", handleMaskClick, { signal });
    sidebar.addEventListener("click", handleLinkClick, { signal });
    mobile.addEventListener("change", updateBodyScroll, { signal });
    sidebar.classList.add("mounted");
  });
</script>
