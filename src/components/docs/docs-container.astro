---
import { getDocAlerts } from "@lib/constants/docs-alerts";
import type { DocChannel } from "@lib/seo";

import DocMeta from "./doc-meta.astro";
import DocsAlert from "./docs-alert.astro";

import "@styles/docs-container.css";

interface Props {
  html: string;
  file: string;
  version: string;
  name: string;
  channel: DocChannel;
}

const { html, file, version, name, channel } = Astro.props;
const alerts = getDocAlerts(file, version);
---

<div class="w-0 flex-1 bg-white dark:bg-dark-gray-900">
  <DocMeta name={name} channel={channel} />
  <div class="mx-auto p-4 lg:max-w-[90%] lg:px-0">
    {alerts.map((alert) => <DocsAlert {...alert} />)}
    <div
      class="docs-content text-gray-900 dark:text-gray-200"
      set:html={html}
    />
  </div>
</div>
