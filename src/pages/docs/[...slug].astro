---
import { Font } from "astro:assets";

import BackToTop from "@components/docs/back-to-top.astro";
import DocsContainer from "@components/docs/docs-container.astro";
import Header from "@components/docs/header.astro";
import Footer from "@components/footer.astro";
import Sidebar from "@components/sidebar/sidebar.astro";
import Layout from "@layouts/layout.astro";

import { getLastModified, lastModifiedFor } from "@lib/docs/lastmod";
import { processDocFile } from "@lib/docs/process-file";
import { Locale } from "@lib/i18n";
import { docMarkdownPath } from "@lib/markdown";
import { getOgImageUrl } from "@lib/og-image";
import type { DocChannel } from "@lib/seo";
import {
  getBreadcrumbTrail,
  getDocumentDescription,
  getDocumentTitle,
} from "@lib/seo";
import { breadcrumbSchema, docSchema } from "@lib/structured-data";
import { getTags } from "@lib/tags";
import { getVersionTag } from "@lib/tags/util";
import { Tag } from "@lib/types";
import { bedrockVersionsInOrder } from "@lib/versions/helpers";
import { allFilesList } from "@lib/versions/list";

export async function getStaticPaths() {
  const versions = await allFilesList(Locale.English);
  const tags = await getTags(Locale.English);
  const paths = [];

  // Generate paths from versions structure - no file processing here
  for (const [major, minor, files] of bedrockVersionsInOrder(versions)) {
    for (const file of files) {
      const version = [major, minor];

      // Main versioned route: /docs/major/minor/file
      paths.push({
        params: { slug: `${major}/${minor}/${file}` },
        props: {
          pathInfo: [major, minor, file],
          tags,
        },
      });

      // Tagged routes (stable/beta)
      const tag = getVersionTag(version, tags);
      if (tag === Tag.Stable) {
        paths.push({
          params: { slug: `stable/${file}` },
          props: {
            pathInfo: [major, minor, file],
            tags,
          },
        });
      } else if (tag === Tag.Beta) {
        paths.push({
          params: { slug: `beta/${file}` },
          props: {
            pathInfo: [major, minor, file],
            tags,
          },
        });
      }
    }
  }

  return paths;
}

const { tags, pathInfo } = Astro.props;
const [major, minor, file] = pathInfo;

const processedDoc = await processDocFile([major, minor, file], Locale.English);
if (!processedDoc) {
  return Astro.redirect("/404");
}

const { html, sidebar, headings, title: docTitle } = processedDoc;

const versions = await allFilesList(Locale.English);

const slugRaw = Astro.params.slug;
const slugParts = slugRaw.split("/").filter(Boolean);

const isStableRoute = slugParts[0] === "stable";
const isBetaRoute = slugParts[0] === "beta";

// Build page title and description
const documentTitle = docTitle.title || file || "Documentation";
const htmlVersion = docTitle.version || minor;

const channel: DocChannel = {
  tag: isStableRoute ? Tag.Stable : isBetaRoute ? Tag.Beta : null,
  version: htmlVersion,
  major,
  minor,
};

const title = getDocumentTitle({ name: documentTitle, channel });
const description = getDocumentDescription({
  name: documentTitle,
  channel,
  headings,
});

// only the tagged routes have a markdown twin
const markdownHref =
  isStableRoute || isBetaRoute ? docMarkdownPath(slugParts[0], file) : null;

const structuredData = [
  docSchema({
    title: documentTitle,
    description,
    path: Astro.url.pathname,
    version: htmlVersion,
    dateModified: lastModifiedFor(getLastModified(), major, minor, file),
  }),
  breadcrumbSchema(getBreadcrumbTrail({ name: documentTitle, channel })),
];

// OG image URL
const versionParam = isStableRoute || isBetaRoute ? slugParts[0] : htmlVersion;
const ogImageUrl = getOgImageUrl({ file, version: versionParam });
---

<Layout
  title={title}
  description={description}
  ogImage={ogImageUrl}
  ogType="article"
>
  <Fragment slot="head">
    <Font cssVariable="--font-fira-code" preload />
    <Font cssVariable="--font-monocraft" />

    <meta name="docsearch:language" content={Locale.English} />
    <link rel="expect" href="#end-of-content" blocking="render" />
    {
      markdownHref && (
        <link rel="alternate" type="text/markdown" href={markdownHref} />
      )
    }
    {
      structuredData.map((schema) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      ))
    }
  </Fragment>

  <Header transition:persist="header" />
  <div class="flex">
    <Sidebar
      sidebar={sidebar}
      file={file}
      major={major}
      minor={minor}
      versions={versions}
      tags={tags}
    />
    <DocsContainer
      html={html}
      file={file}
      version={minor}
      name={documentTitle}
      channel={channel}
    />
  </div>
  <div id="end-of-content"></div>
  <BackToTop />
  <Footer
    dark={true}
    darkClassName="bg-dark-gray-975"
    showToggles={false}
    outline={true}
  />
</Layout>
