---
import Footer from "@components/footer.astro";
import Navbar from "@components/homepage/navbar.astro";
import Layout from "@layouts/layout.astro";

import { t } from "@lib/i18n";
---

<Layout title="404 | bedrock.dev" description={t("page.not_found.message")}>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <div class="flex min-h-screen flex-col justify-between">
    <Navbar />

    <div class="mx-auto mt-8 mb-10 max-w-7xl px-4 text-center sm:px-6 md:px-8">
      <h4 class="text-6xl font-bold text-black dark:text-gray-200">404</h4>
      <p class="mt-4 text-lg text-gray-500 dark:text-gray-400">
        {t("page.not_found.message")}{" "}
        <a class="link" href="/">{t("page.not_found.home_link")}</a>
      </p>
    </div>

    <Footer />
  </div>
</Layout>
