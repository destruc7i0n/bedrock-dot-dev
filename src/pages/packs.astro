---
import Footer from "@components/footer.astro";
import Navbar from "@components/homepage/navbar.astro";
import PackCard from "@components/packs/pack-card.astro";
import Layout from "@layouts/layout.astro";

import { t } from "@lib/i18n";
import { getPackVersions } from "@lib/packs";

const { versions, sorted: versionsSorted } = await getPackVersions();
---

<Layout
  title={`${t("page.packs.website_title")} | bedrock.dev`}
  description={t("page.packs.website_description")}
>
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href="/packs.md" />
  </Fragment>

  <div class="h-screen">
    <Navbar />

    <div class="mx-auto mb-10 mt-8 max-w-screen-xl px-4 sm:px-6 md:px-8">
      <div class="mx-auto max-w-screen-lg space-y-4">
        <h4 class="text-4xl font-bold text-black dark:text-gray-200">
          {t("page.packs.title")}
        </h4>
        <p class="text-lg text-black dark:text-gray-200">
          This is an archive of the default template packs provided by Mojang.
          The latest packs are available in Mojang's{" "}
          <a
            class="link"
            href="https://github.com/Mojang/bedrock-samples?ref=bedrock.dev"
            target="_blank"
            rel="noopener"
          >
            bedrock-samples
          </a>{" "}
          GitHub repository. Older ones can be found in the{" "}
          <a
            class="link"
            href="https://github.com/bedrock-dot-dev/packs"
            target="_blank"
            rel="noopener"
          >
            bedrock-dot-dev/packs
          </a>{" "}
          repository.
        </p>

        <div
          class="grid grid-cols-2 gap-4 font-normal md:grid-cols-3 lg:grid-cols-4"
        >
          {
            versionsSorted.map((v) => {
              const versionData = versions[v];
              return <PackCard versionName={v} versionData={versionData} />;
            })
          }
        </div>
      </div>
    </div>

    <div class="mt-10">
      <Footer dark={true} />
    </div>
  </div>
</Layout>
