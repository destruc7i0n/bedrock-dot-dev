{
  "name": "bedrock-dev",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run build:prepare && pnpm run build:astro && pnpm run ping-indexnow",
    "build:prepare": "pnpm run update-docs && pnpm run generate-docs-file && pnpm run generate-sitemap",
    "build:astro": "astro build",
    "start": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "ping-indexnow": "tsx scripts/ping-indexnow.ts",
    "generate-docs-file": "tsx scripts/generate-docs-manifest.ts",
    "generate-vercel-redirects": "tsx scripts/generate-vercel-redirects.ts",
    "type-check": "tsc --noEmit",
    "update-docs": "git submodule update --init --recursive --remote",
    "postinstall": "pnpm run update-docs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/vercel": "^11.0.8",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@docsearch/css": "^3.9.0",
    "@docsearch/react": "^3.9.0",
    "@heroicons/react": "^2.2.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^1.1.0",
    "astro": "^7.2.7",
    "clsx": "^2.1.1",
    "flat-cache": "^6.1.23",
    "i18next": "^26.4.0",
    "nanostores": "^1.5.2",
    "nprogress": "^0.2.0",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.12",
    "sitemap": "^9.0.1",
    "tailwind-merge": "3.6.0",
    "takumi-js": "^2.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/nprogress": "^0.2.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "isomorphic-unfetch": "^4.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "license": "GPL-3.0"
}
