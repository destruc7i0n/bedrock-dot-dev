{
  "name": "bedrock-dev",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "turbo run dev:astro",
    "build": "bun run update-docs && turbo run build:astro && bun run ping-indexnow",
    "build:astro": "bunx --bun astro build",
    "start": "bunx --bun astro preview",
    "astro": "bunx --bun astro",
    "check": "bunx --bun astro check",
    "ping-indexnow": "bun scripts/ping-indexnow.ts",
    "type-check": "bunx --bun tsc --noEmit",
    "update-docs": "git submodule update --init --recursive --remote",
    "postinstall": "bun run update-docs",
    "dev:astro": "bunx --bun astro dev",
    "docs:manifest": "bun scripts/generate-docs-manifest.ts",
    "docs:process": "bun scripts/process-docs.ts",
    "docs:lastmod": "bun scripts/generate-lastmod.ts",
    "sitemap": "bun scripts/generate-sitemap.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@astrojs/vercel": "^11.0.8",
    "@docsearch/css": "^5.0.4",
    "@docsearch/react": "^5.0.4",
    "@heroicons/react": "^2.2.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^1.1.0",
    "astro": "^7.2.7",
    "clsx": "^2.1.1",
    "i18next": "^26.4.0",
    "nanostores": "^1.5.2",
    "nprogress": "^0.2.0",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.12",
    "sitemap": "^9.0.1",
    "tailwind-merge": "3.6.0",
    "takumi-js": "^2.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "^26.3.0",
    "@types/nprogress": "^0.2.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-turbo": "^2.11.2",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "license": "GPL-3.0"
}
